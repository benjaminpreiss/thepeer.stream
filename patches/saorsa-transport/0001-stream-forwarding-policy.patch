+/// A decision point in the stream forwarding path. Packet contents and credentials
+/// are deliberately not exposed to the policy.
+#[derive(Clone, Copy, Debug)]
+pub enum StreamForwardEvent {
+    /// Reserve frame work/bytes BEFORE allocating its buffer. Includes the four
+    /// prefix bytes; a keepalive therefore costs four bytes, not zero.
+    Frame {
+        /// Declared frame size including its four-byte prefix.
+        wire_bytes: usize,
+    },
+    /// Immediately before sending a decoded datagram to its requested target.
+    Send {
+        /// Destination decoded from the client's untrusted frame.
+        target: SocketAddr,
+        /// UDP payload length, excluding relay framing.
+        payload_bytes: usize,
+    },
+    /// Before copying or queueing a datagram received from a UDP source.
+    Receive {
+        /// Source reported by the allocated UDP socket.
+        source: SocketAddr,
+        /// UDP payload length, excluding relay framing.
+        payload_bytes: usize,
+    },
+}
+
+/// Authorization is synchronous and non-blocking; optional pacing may suspend.
+/// All callbacks must be non-panicking. Implementations must bind
+/// relay-internal session IDs to trusted connection/pairing state, not source-IP
+/// identity. Unknown/revoked sessions must be denied. A false Frame/Send decision
+/// closes the forwarding session through normal cleanup; false Receive drops the
+/// packet (an unrelated UDP sender must not be able to close the session).
+pub trait StreamForwardPolicy: Send + Sync + 'static {
+    /// Atomically reserve any applicable budget and authorize this operation.
+    fn permit(&self, session_id: u64, event: StreamForwardEvent) -> bool;
+
+    /// Await ordinary bandwidth availability AFTER synchronous authorization.
+    /// Called only for Send/Receive, never Frame. Returning false ends the session;
+    /// temporary bandwidth exhaustion should wait, not return false. The future
+    /// must be cancellation-safe: closing the session drops/aborts the wait.
+    /// Callers must choose the accounting point so a relayed packet is not charged
+    /// twice, and share one bucket across both directions of a pairing. Revocation
+    /// must cancel the session or be observed by this future before allowing send.
+    fn pace(
+        &self,
+        _session_id: u64,
+        _event: StreamForwardEvent,
+    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = bool> + Send + '_>> {
+        Box::pin(async { true })
+    }
+}
+
+/// Explicit client-frame and UDP-to-stream queue bounds. The Receive policy must
+/// separately bound accepted UDP payload sizes (the socket buffer is 64 KiB).
+/// These do not limit handshakes, allocations, total sessions, or other paths.
+#[derive(Clone, Copy, Debug)]
+pub struct StreamForwardLimits {
+    max_frame_bytes: usize,
+    queue_packets: usize,
+}
+impl StreamForwardLimits {
+    /// Maximum client frame body bytes and UDP-to-stream queue entries. Reject
+    /// invalid/excessive settings rather than silently selecting defaults.
+    pub fn new(max_frame_bytes: usize, queue_packets: usize) -> Option<Self> {
+        if max_frame_bytes == 0
+            || max_frame_bytes > 512 * 1024
+            || queue_packets == 0
+            || queue_packets > RELAY_FORWARD_CHANNEL_CAPACITY
+        {
+            return None;
+        }
+        Some(Self {
+            max_frame_bytes,
+            queue_packets,
+        })
+    }
+}

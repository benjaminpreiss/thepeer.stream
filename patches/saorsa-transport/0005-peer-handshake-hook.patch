+//! Optional handshake ownership hooks. Virtual ingress is opt-in. No attempt policy.
+use crate::high_level::{Connecting, Endpoint, Incoming};
+use parking_lot::Mutex;
+use std::{net::SocketAddr, sync::Arc};
+
+/// A coordinator-triggered dial using the endpoint's existing client crypto.
+/// Consuming this value starts the normal dial; dropping it skips that dial.
+/// Addresses are routing hints, not authenticated identities.
+pub struct PeerDial {
+    endpoint: Endpoint,
+    address: SocketAddr,
+}
+impl PeerDial {
+    pub(crate) fn new(endpoint: Endpoint, address: SocketAddr) -> Self {
+        Self { endpoint, address }
+    }
+    /// The requested routing address.
+    pub fn remote_address(&self) -> SocketAddr {
+        self.address
+    }
+    /// Start with the existing crypto configuration and retain the actual attempt.
+    pub fn connect(self) -> Result<Connecting, crate::ConnectError> {
+        self.endpoint.connect(self.address, "localhost")
+    }
+}
+
+/// Optional application ownership, not a one-shot receiver or fallback policy.
+/// Return the ORIGINAL value for normal Saorsa handling, or None after consuming
+/// it (including dropping/refusing it). Owned attempts require full TLS completion.
+/// Handlers must be synchronous, non-blocking, non-panicking and thread-safe.
+/// Calls already selected before removal can still run afterward; handlers own
+/// synchronization/cancellation of their queues and transferred work.
+pub trait PeerHandshakeHandler: Send + Sync {
+    /// Handle ordinary-UDP incoming before Saorsa starts its TLS handshake.
+    fn incoming(&self, incoming: Incoming) -> Option<Incoming> {
+        Some(incoming)
+    }
+    /// Opt into virtual-socket incoming ownership before TLS starts. The default
+    /// returns the original incoming to Saorsa, and never calls `incoming`.
+    /// This keeps ordinary-only handlers (such as coordination) isolated.
+    fn incoming_virtual(&self, incoming: Incoming) -> Option<Incoming> {
+        Some(incoming)
+    }
+    /// Handle a coordination dial before it starts; default uses the normal path.
+    fn outgoing(&self, dial: PeerDial) -> Option<PeerDial> {
+        Some(dial)
+    }
+    /// Called once on removal, shutdown, or failed/cancelled opted-in construction
+    /// after installation, outside registry locks.
+    /// Already selected callbacks and already transferred connections remain the
+    /// handler/caller's responsibility. No implicit close or timeout is imposed.
+    fn detached(&self) {}
+}
+
+/// Identity of one installation. Dropping/cloning it does not remove the hook.
+/// Removal compares installation identities, not handler pointers: an old token
+/// cannot remove a later installation of the same handler object.
+#[derive(Clone, Debug)]
+pub struct HandshakeRegistration(Arc<()>);
+
+/// Installation failure; neither case replaces an existing handler.
+#[derive(Debug)]
+pub enum HandlerInstallError {
+    /// Remove the existing installation explicitly before installing another.
+    Occupied,
+    /// The endpoint has shut down.
+    Stopped,
+}
+#[derive(Default)]
+struct State {
+    stopped: bool,
+    installed: Option<(HandshakeRegistration, Arc<dyn PeerHandshakeHandler>)>,
+}
+#[derive(Default)]
+pub(crate) struct HandshakeHooks(Mutex<State>);
+
+// Closing a failed/cancelled construction must not restore default acceptance.
+// Successful construction disarms this guard and transfers shutdown to the endpoint.
+pub(crate) struct ConstructionHooks(pub(crate) Option<Arc<HandshakeHooks>>);
+impl Drop for ConstructionHooks {
+    fn drop(&mut self) {
+        if let Some(hooks) = self.0.take() {
+            hooks.shutdown();
+        }
+    }
+}
+impl HandshakeHooks {
+    pub(crate) fn is_stopped(&self) -> bool {
+        self.0.lock().stopped
+    }
+    pub(crate) fn install(
+        &self,
+        handler: Arc<dyn PeerHandshakeHandler>,
+    ) -> Result<HandshakeRegistration, HandlerInstallError> {
+        let mut state = self.0.lock();
+        if state.stopped {
+            return Err(HandlerInstallError::Stopped);
+        }
+        if state.installed.is_some() {
+            return Err(HandlerInstallError::Occupied);
+        }
+        let key = HandshakeRegistration(Arc::new(()));
+        state.installed = Some((key.clone(), handler));
+        Ok(key)
+    }
+    pub(crate) fn remove(&self, key: &HandshakeRegistration) -> bool {
+        let old = {
+            let mut state = self.0.lock();
+            match &state.installed {
+                Some((active, _)) if Arc::ptr_eq(&active.0, &key.0) => state.installed.take(),
+                _ => None,
+            }
+        };
+        if let Some((_, handler)) = old {
+            handler.detached();
+            true
+        } else {
+            false
+        }
+    }
+    pub(crate) fn current(&self) -> Option<Arc<dyn PeerHandshakeHandler>> {
+        self.0
+            .lock()
+            .installed
+            .as_ref()
+            .map(|(_, handler)| handler.clone())
+    }
+    pub(crate) fn shutdown(&self) {
+        let old = {
+            let mut state = self.0.lock();
+            state.stopped = true;
+            state.installed.take()
+        };
+        if let Some((_, handler)) = old {
+            handler.detached();
+        }
+    }
+}
